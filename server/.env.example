PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/surveillance
# Long random string used to sign admin login tokens
JWT_SECRET=replace-with-a-long-random-string
# Shared secret, must equal INGEST_API_KEY in ai-service/.env
INGEST_API_KEY=change-me-ingest-key
AI_SERVICE_URL=http://localhost:8000

# Gmail SMTP. SMTP_PASS is a 16-character Gmail App Password, NOT your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=abcdabcdabcdabcd
# Default alert recipients (comma separated); editable later on the Settings page
ALERT_TO=your.address@gmail.com

# First admin account, created by `npm run seed` (and automatically on first start)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# Admin panel URL, used for CORS and for links inside alert emails
CLIENT_URL=http://localhost:5173
